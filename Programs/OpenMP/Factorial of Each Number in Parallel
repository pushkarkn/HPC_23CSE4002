#include <iostream>
#include <vector>
#include <omp.h>

unsigned long long factorial(int n) {
    unsigned long long result = 1;
    for (int i = 2; i <= n; i++) {
        result *= i;
    }
    return result;
}

int main() {
    std::vector<int> numbers = {5, 7, 3, 10, 4, 8, 6, 9};
    int n = numbers.size();
    std::vector<unsigned long long> results(n);
    
    #pragma omp parallel for
    for (int i = 0; i < n; i++) {
        results[i] = factorial(numbers[i]);
    }
    
    for (int i = 0; i < n; i++) {
        std::cout << numbers[i] << "! = " << results[i] << "\n";
    }
    
    return 0;
}
