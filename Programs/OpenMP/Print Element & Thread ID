#include <iostream>
#include <vector>
#include <omp.h>

int main() {
    const int N = 20;
    std::vector<int> arr(N);
    
    // Initialize array
    for (int i = 0; i < N; i++) {
        arr[i] = i + 1;
    }
    
    #pragma omp parallel for
    for (int i = 0; i < N; i++) {
        printf("Thread %d processed element arr[%d] = %d\n", 
               omp_get_thread_num(), i, arr[i]);
    }
    
    return 0;
}
