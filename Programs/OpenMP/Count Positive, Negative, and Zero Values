#include <iostream>
#include <vector>
#include <omp.h>

int main() {
    std::vector<int> arr = {5, -3, 0, 12, -8, 0, 7, -1, 0, 4, -9, 2};
    int n = arr.size();
    int positive = 0, negative = 0, zero = 0;
    
    #pragma omp parallel for reduction(+:positive, negative, zero)
    for (int i = 0; i < n; i++) {
        if (arr[i] > 0)      positive++;
        else if (arr[i] < 0) negative++;
        else                 zero++;
    }
    
    std::cout << "Positive: " << positive << "\n";
    std::cout << "Negative: " << negative << "\n";
    std::cout << "Zero:     " << zero << "\n";
    
    return 0;
}
