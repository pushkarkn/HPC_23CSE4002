#include <iostream>
#include <vector>
#include <omp.h>
#include <climits>

int main() {
    std::vector<int> arr = {34, -12, 89, 5, 102, -45, 67, 0, 999, 23};
    int n = arr.size();
    int max_val = INT_MIN;
    
    #pragma omp parallel for reduction(max:max_val)
    for (int i = 0; i < n; i++) {
        if (arr[i] > max_val) {
            max_val = arr[i];
        }
    }
    
    std::cout << "Largest element: " << max_val << "\n";
    
    return 0;
}
