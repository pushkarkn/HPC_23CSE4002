#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

#define N 10

int main()
{
int A[N], B[N], C[N];

for(int i= 0; i< N; i++)
{
    A[i]= i;
    B[i]= i*2;

}
#pragma omp parallel for 
for (int i= 0; i<N; i++)
{ 
    C[i]= A[i]+B[i];
}
printf("Verification (showing first 5 elements):\n");
    for (int i = 0; i < 10; i++) {
        printf("A[%d] (%d) + B[%d] (%d) = C[%d] (%d)\n", i, A[i], i, B[i], i, C[i]);
    }

return 0;
}
